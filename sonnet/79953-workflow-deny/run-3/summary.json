{
  "experiment": "79953-workflow-deny",
  "claude_code": "2.1.330 (Claude Code)",
  "os_version": "27.3",
  "kernel": "Darwin 27.3.0 arm64",
  "model": "claude-sonnet-5-5",
  "permission_mode": "bypassPermissions",
  "hook_mode": "exit2-workflow",
  "exit_status": 0,
  "main_tools_include": {
    "Bash": true,
    "Agent": true,
    "Write": true
  },
  "plugins": [
    "cc-plugin-agents-md@builtin",
    "cc-plugin-privacy@builtin",
    "cc-plugin-plugin-authoring@builtin"
  ],
  "hooks_run": [
    {
      "name": "PostToolUse:Skill",
      "n": 1
    },
    {
      "name": "PreToolUse:Skill",
      "n": 1
    },
    {
      "name": "PreToolUse:Workflow",
      "n": 1
    }
  ],
  "agent_calls": [
    {
      "where": "main",
      "tool": "Workflow",
      "subagent_type": null,
      "run_in_background": null
    }
  ],
  "subagent_starts": [],
  "sidecar_at_subagent_start": [],
  "sidecar_at_first_tool": [],
  "sidecars_final": [],
  "session_ids": 1,
  "session_id_is_main": true,
  "prompt_ids": 1,
  "subagent_events_with_agent_id": 0,
  "denials": [
    {
      "tool": "Workflow",
      "owner": "main"
    }
  ],
  "project_files": [
    "file.txt"
  ],
  "verdict": {
    "bash_ok_subagent": 0,
    "bash_ok_main": 0,
    "bash_attempt_subagent": 0,
    "write_attempt_subagent": 0,
    "write_ok_subagent": 0,
    "write_attempt_main": 0,
    "probe_files_left": 0,
    "agent_pretooluse": 0,
    "workflow_pretooluse": 1,
    "subagent_start": 0,
    "denials_subagent": 0,
    "denials_main": 1,
    "denials_unknown": 0,
    "result_errors": 0,
    "bash_tool_use_in_subagent_transcripts": 0,
    "bash_refused_as_unavailable": 0
  }
}
